# =============================================================================
# Variables de entorno — vanemis-landingpage
# =============================================================================
# Copia este archivo a `.env` para desarrollo local y rellena los valores.
# En Vercel se configuran en Settings -> Environment Variables (los mismos
# nombres, sin comillas), marcadas para Production, Preview y Development.
#
# `.env` esta en .gitignore. Este archivo NO debe contener valores reales.
# -----------------------------------------------------------------------------

# --- Formulario de contacto -------------------------------------------------
# Buzon que recibe los avisos de nuevo lead. Lo lee runtimeConfig.contactEmail.
NUXT_CONTACT_EMAIL=

# Clave de API de Resend (https://resend.com/api-keys). Empieza por `re_`.
# Secreto de servidor: nunca se expone al cliente.
NUXT_RESEND_API_KEY=

# --- Imagenes Open Graph ----------------------------------------------------
# Cadena aleatoria que firma las peticiones a /_og/. Generala con
# `openssl rand -hex 32` o cualquier valor largo y unico.
NUXT_OG_IMAGE_SECRET=

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API en el panel de Supabase.
#
# Solo se usan en servidor, desde server/utils/leadService.ts. La landing no
# habla con Supabase desde el navegador, por eso NO hace falta la clave
# publicable (`SUPABASE_KEY`): se retiro junto con el modulo @nuxtjs/supabase.
# Si algun dia el dashboard necesita cliente de navegador, habra que volver a
# instalarlo y anadirla.

# URL del proyecto, del tipo https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clave secreta (antes «service_role»). Salta el RLS: SOLO servidor.
SUPABASE_SECRET_KEY=
